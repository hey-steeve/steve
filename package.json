{
  "name": "steve",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "node tooling/typecheck.js",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm --filter @steve/app build && node tooling/check-voice-client-bundle.mjs",
    "eval:emergency": "pnpm --filter @steve/app eval:emergency",
    "eval:triage": "node --experimental-strip-types features/triage/eval/run.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
