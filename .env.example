# Names the repo reads from the environment. Leave the values empty in git.
# Next.js loads app/.env.local, beside next.config.ts. .env.local is gitignored.

# OpenRouter API key. The chat route reads it on the server.
OPENROUTER_API_KEY=

# Model id sent to OpenRouter. Empty sends google/gemini-3.8-flash.
OPENROUTER_MODEL=

# Set to 1 to call OpenRouter. Empty keeps the canned reply.
STEVE_CHAT_LIVE=
