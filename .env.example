# Names the repo reads from the environment. Leave the values empty in git.
# Next.js loads app/.env.local, beside next.config.ts. .env* is gitignored, except this file.

# OpenRouter API key. The chat route reads it on the server.
OPENROUTER_API_KEY=

# Model id sent to OpenRouter. Empty uses the pinned default, openai/gpt-6.1-terra.
OPENROUTER_MODEL=

# Set to 1 to call OpenRouter. Live mode also needs OPENROUTER_API_KEY.
# Any value other than 1 keeps the canned reply.
STEVE_CHAT_LIVE=
